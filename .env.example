# Copiar a .env: cp .env.example .env
# Docker Compose lee este archivo automáticamente.

# --- PostgreSQL ---
POSTGRES_USER=bidcraft
POSTGRES_PASSWORD=bidcraft
POSTGRES_DB=bidcraft
# Puerto publicado en el host.
POSTGRES_PORT=5432

# --- Backend ---
# Puerto publicado en el host (dentro del contenedor siempre escucha en 8080).
BACKEND_PORT=8080
JWT_SECRET=change-me

# Solo se usan al ejecutar el binario fuera de Docker;
# en Compose el backend recibe DATABASE_URL apuntando al servicio "postgres".
PORT=8080
DATABASE_URL=postgres://bidcraft:bidcraft@localhost:5432/bidcraft?sslmode=disable

# --- Frontend ---
FRONTEND_PORT=4321
PUBLIC_API_URL=http://localhost:8080
